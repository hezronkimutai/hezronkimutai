{
  "name": "hezronkimutai-portfolio",
  "version": "1.0.0",
  "description": "Hezron Kimutai's Personal Portfolio Website",
  "main": "index.tsx",
  "scripts": {
    "coveralls": "jest --config jest.config.js --coverage --coverageReporters=text-lcov | coveralls",
    "test": "jest --config jest.config.js --coverage",
    "dev": "webpack-dev-server --mode development --hot --open --config webpack.config.babel.js",
    "build": "webpack --mode production --config webpack.config.babel.js",
    "start": "serve -s ./dist",
    "snap:fix": "npm test -- -u",
    "lint": "eslint --fix ./",
    "deploy": "aws s3 sync dist/ s3://hezronkimutai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hezronkimutai/hezronkimutai"
  },
  "author": "Hezron Kimutai",
  "keywords": [
    "portfolio",
    "react",
    "typescript",
    "blog",
    "personal-website"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hezronkimutai/hezronkimutai/issues"
  },
  "homepage": "https://hezron.netlify.app",
